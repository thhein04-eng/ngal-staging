{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@org/api/products": ["./packages/api/products/src/index.ts"],
      "@org/models": ["./packages/shared/models/src/index.ts"],
      "@org/shop/data": ["./packages/shop/data/src/index.ts"],
      "@org/shop/feature-about": [
        "./packages/shop/feature-about/src/index.ts"
      ],
      "@org/shop/feature-contact": [
        "./packages/shop/feature-contact/src/index.ts"
      ],
      "@org/shop/feature-home": ["./packages/shop/feature-home/src/index.ts"],
      "@org/shop/feature-portfolio": [
        "./packages/shop/feature-portfolio/src/index.ts"
      ],
      "@org/shop/feature-services": [
        "./packages/shop/feature-services/src/index.ts"
      ],
      "@org/shop/shared-ui": ["./packages/shop/shared-ui/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
